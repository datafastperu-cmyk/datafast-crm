# ==============================================================
# CRM ISP DATAFAST — .gitignore
# ==============================================================

# ── Entorno ───────────────────────────────────────────────────
.vps.env
.env
.env.local
.env.production
.env.staging
*.env

# ── Temporales de desarrollo / auditoria ──────────────────────
__pycache__/
*.pyc
.playwright-mcp/
*.BACKUP
build-log-*.txt
audit_*.png
verify_*.png
debug_*.png
red_redes_*.png
redes_*.png
verificacion_*.png

# ── SSL y certificados ────────────────────────────────────────
nginx/ssl/live/
nginx/ssl/*.crt
nginx/ssl/*.key
nginx/ssl/*.pem
*.pfx
*.p12
certs/

# ── Node.js ───────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── NestJS / TypeScript ───────────────────────────────────────
backend/dist/
backend/build/
*.js.map
*.d.ts

# ── Next.js ───────────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
log/
# Excepción: rutas Next.js que se llaman "log"
!frontend/src/**/log/
!frontend/src/**/log/**

# ── Uploads (no versionar archivos subidos por usuarios) ──────
backend/uploads/
uploads/

# ── Backups ───────────────────────────────────────────────────
backups/
*.sql
*.sql.gz
*.dump

# ── IDEs ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Testing ───────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Docker volumes locales ────────────────────────────────────
.docker/

# ── Herramientas privadas de licencias (NUNCA versionar) ──────
tools/private.pem
tools/generate-license.js

# ── Credenciales locales (NUNCA versionar ni subir a VPS) ─────
ACCESOS.local.md

# ── Artefactos PWA generados por next-pwa/workbox ──────────────
# Se regeneran en CADA build con los hashes de los chunks, así que versionarlos
# garantiza un conflicto en cada despliegue: el 2026-07-28 un `sw.js` modificado en la
# VPS abortó un `git pull` y el deploy reportó "Updating..." sin haber aplicado nada.
# Un artefacto de build no se versiona.
frontend/public/sw.js
frontend/public/sw.js.map
frontend/public/workbox-*.js
frontend/public/workbox-*.js.map

# ── Artefactos de build de TypeScript ──────────────────────────
frontend/tsconfig.tsbuildinfo
backend/tsconfig.tsbuildinfo

# ── Scripts ad-hoc de depuración contra la VPS ─────────────────
# La directriz del proyecto es que los scripts de red viven en
# Proyecto_CRM_ISP/mikrotik-network/, nunca dentro del repo del ERP. Se ignoran en vez
# de borrarse: son del operador, no del proyecto.
_*.mjs
vps.config.mjs
