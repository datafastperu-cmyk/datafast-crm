# URL del backend NestJS
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL del WebSocket (puede ser igual al backend)
NEXT_PUBLIC_WS_URL=http://localhost:4000

# CRM WhatsApp: corre en su propio proceso PM2 (datafast-whatsapp) porque aloja
# Chromium. Next reescribe /api/v1/crm-nativo/* y /wa-socket/* hacia aquí; si
# apunta al backend principal, la pantalla del CRM se queda en "Iniciando cliente…"
# porque ese proceso no tiene el cliente. Solo se cambia si el proceso no está en
# la misma máquina que Next.
WA_API_URL=http://localhost:4002

# Nombre de la empresa (se muestra en la UI)
NEXT_PUBLIC_APP_NAME=CRM ISP DATAFAST

# Versión
NEXT_PUBLIC_VERSION=1.0.0

# ── Mapa de Red ────────────────────────────────────────────────────
# Fuente de teselas del mapa base. Por defecto OpenStreetMap, válido para el
# volumen de un ERP interno (unos pocos operadores).
#
# NO se usan las teselas de Google aunque el ERP tenga clave de Maps: sus
# términos exigen renderizarlas con el SDK de Google, y usarlas dentro de
# MapLibre los incumple.
#
# La política de OSM prohíbe la descarga masiva, así que el modo offline exigirá
# auto-hospedar las teselas o usar vectoriales propias (PMTiles). Cuando se haga,
# se cambia esta URL — no hay que tocar código.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIB=© OpenStreetMap contributors

# Centro inicial del mapa cuando todavía no hay planta cargada. Cámbialo a la
# ciudad de cada instalación; por defecto Lima.
NEXT_PUBLIC_MAPA_LAT=-12.0464
NEXT_PUBLIC_MAPA_LNG=-77.0428
