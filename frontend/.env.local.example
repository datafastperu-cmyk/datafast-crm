# URL del backend NestJS
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL del WebSocket (puede ser igual al backend)
NEXT_PUBLIC_WS_URL=http://localhost:4000

# CRM WhatsApp: corre en su propio proceso PM2 (datafast-whatsapp) porque aloja
# Chromium. Next reescribe /api/v1/crm-nativo/* y /wa-socket/* hacia aquí; si
# apunta al backend principal, la pantalla del CRM se queda en "Iniciando cliente…"
# porque ese proceso no tiene el cliente. Solo se cambia si el proceso no está en
# la misma máquina que Next.
WA_API_URL=http://localhost:4002

# Nombre de la empresa (se muestra en la UI)
NEXT_PUBLIC_APP_NAME=CRM ISP DATAFAST

# Versión
NEXT_PUBLIC_VERSION=1.0.0
